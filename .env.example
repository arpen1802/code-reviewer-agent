# Get your free Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Optional: Langfuse tracing — https://cloud.langfuse.com (free tier).
# Leave these unset to run without tracing. When both keys are present,
# every code review produces a Langfuse trace with per-Gemini-call token
# counts, tool spans, and a shared session_id that groups the orchestrator
# and the three specialist agents in the Sessions view.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud: https://cloud.langfuse.com  |  US cloud: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
